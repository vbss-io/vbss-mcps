    "spreadsheet"
  ],
  "license": "MIT",
  "author": "Vitor Bastos <vitor@vbss.io> (https://vbss.io/)",
  "homepage": "https://github.com/vbss-io/vbss-mcps/tree/main/packages/excel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbss-io/vbss-mcps.git",
    "directory": "packages/excel"
  },
  "bugs": {
    "url": "https://github.com/vbss-io/vbss-mcps/issues"
  },
  "main": "src/index.js",
