{
  "name": "@vbss-ai/mcp-mongodb-readonly",
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only multi-org MongoDB MCP server compatible with MongoDB and Cosmos DB (MongoDB API)",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mongodb",
    "cosmos-db",
    "database",
    "readonly"
  ],
  "license": "MIT",
  "author": "Vitor Bastos <vitor@vbss.io> (https://vbss.io/)",
  "homepage": "https://github.com/vbss-io/vbss-mcps/tree/main/packages/mongodb-readonly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbss-io/vbss-mcps.git",
    "directory": "packages/mongodb-readonly"
  },
  "bugs": {
    "url": "https://github.com/vbss-io/vbss-mcps/issues"
  },
  "main": "src/index.js",
  "bin": {
    "vbss-mcp-mongodb-readonly": "src/index.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js"
  },
  "mcp": {
    "label": "MongoDB Read-Only",
    "toolPattern": "mcp__mongodb-readonly__*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^16.6.1",
    "mongodb": "^6.21.0",
    "zod": "^3.25.0"
  }
}
